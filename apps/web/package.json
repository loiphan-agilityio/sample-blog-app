{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint -c ../../oxlint.config.ts --type-aware --deny-warnings . && prettier --check .",
    "lint:fix": "oxlint -c ../../oxlint.config.ts --type-aware --fix . && prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "allure generate --clean --open",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build-storybook && pnpm test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.5.0",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "jsdom": "^30.1.3",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "storybook": "^10.6.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
